[Unit]
Description=Monthly refresh of the Novel Tracker Sign in with Apple client secret

# Apple caps the client secret at six months and every Apple sign-in fails the
# moment it lapses, so this runs far more often than strictly required — a
# monthly no-op costs nothing next to a silent outage.
[Timer]
OnCalendar=*-*-01 04:15:00 UTC
Persistent=true
RandomizedDelaySec=30m

[Install]
WantedBy=timers.target
