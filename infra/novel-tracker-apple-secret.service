[Unit]
Description=Refresh the Novel Tracker Sign in with Apple client secret in Keycloak
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/novel-tracker
ExecStart=/usr/bin/docker compose --project-name novel-tracker --env-file /etc/novel-tracker/app.env -f /opt/novel-tracker/compose.yml -f /opt/novel-tracker/compose.production.yml run --rm --no-deps api node scripts/rotate-apple-secret.mjs
