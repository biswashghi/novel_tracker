{
  "manifest_version": 3,
  "name": "Novel Tracker",
  "description": "Track where you stopped reading light novels across different websites.",
  "version": "0.0.0",
  "permissions": [
    "storage",
    "tabs",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://*.royalroad.com/*",
    "https://*.patreon.com/*",
    "https://*.wuxiaworld.com/*",
    "https://*.novelbin.com/*",
    "https://*.scribblehub.com/*",
    "https://*.creativenovels.com/*",
    "https://*.lightnovelstranslations.com/*",
    "https://*.shintranslations.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.royalroad.com/*",
        "https://*.patreon.com/*",
        "https://*.wuxiaworld.com/*",
        "https://*.novelbin.com/*",
        "https://*.scribblehub.com/*",
        "https://*.creativenovels.com/*",
        "https://*.lightnovelstranslations.com/*",
        "https://*.shintranslations.com/*"
      ],
      "js": [
        "lib/parser-core.js",
        "lib/site-parsers/royalroad.js",
        "lib/site-parsers/patreon.js",
        "lib/site-parsers/wuxiaworld.js",
        "lib/site-parsers/novelbin.js",
        "lib/site-parsers/scribblehub.js",
        "lib/site-parsers/creativenovels.js",
        "lib/site-parsers/lightnovelstranslations.js",
        "lib/site-parsers/shintranslations.js",
        "lib/page-metadata.js",
        "content-script.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Novel Tracker",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    },
    "default_popup": "popup.html"
  },
  "options_page": "options.html"
}
