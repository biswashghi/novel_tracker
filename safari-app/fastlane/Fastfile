# Archives and uploads the Safari containing apps produced by
# `npm run package:safari` (scripts/package-safari.sh) to App Store Connect —
# macOS to the App Store (unreleased draft, not submitted for review), iOS to
# TestFlight — using the same APP_STORE_CONNECT_* secrets already wired into
# .github/workflows/release.yml's build-safari job.
#
# This closes the gap scripts/publish-safari.mjs used to leave open (it only
# checked the packaged zip existed and printed a reminder that an Xcode
# archive/export/upload step was still needed). It cannot close the *entire*
# gap: Apple's one-time account setup (Developer Program agreement, the
# initial App Store Connect listing, tax/banking) has to happen once by hand
# before this lane's upload has anywhere to land. From then on, this lane is
# what a release build runs.
#
# Verified against real signed Xcode projects and real App Store Connect
# credentials, both locally and in CI (macos-latest):
# - `build_app` initially failed with "Couldn't find specified scheme ...
#   make sure the scheme is shared" — `xcrun safari-web-extension-converter`
#   doesn't persist any .xcscheme files, only an implicit one Xcode
#   synthesizes on the fly that non-interactive builds can't see.
#   scripts/package-safari.sh now generates real, shared scheme files for
#   both app targets to fix this.
# - CI imports an Apple Distribution identity before these lanes run.
#   Automatic signing still asks for Development identities/profiles during
#   archive on a clean runner, so each lane creates or repairs its own
#   Fastlane-managed App Store profiles against that installed distribution
#   certificate, then switches the Release targets to manual signing. This
#   deliberately avoids Xcode-managed profiles: Apple rejects those when a
#   project explicitly requests manual profile management.
# - iOS lane confirmed working end-to-end for real (a real TestFlight
#   upload). macOS lane confirmed through archive/export/signing; the
#   upload itself can still be blocked independently by App Store Connect
#   account state (e.g. an existing version sitting on unresolved review
#   feedback) — that's Apple's process, not something this lane can bypass.

default_platform(:mac)

PROJECT = ENV["NOVEL_TRACKER_XCODE_PROJECT"] ||
  File.expand_path("../../build/safari-xcode/Novel Tracker/Novel Tracker.xcodeproj", __dir__)

# `xcrun safari-web-extension-converter` names each platform's app target
# scheme after the --app-name passed in scripts/package-safari.sh
# ("Novel Tracker"), suffixed with the platform. Override if your generated
# project uses different scheme names.
MAC_SCHEME = ENV["NOVEL_TRACKER_XCODE_SCHEME"] || "Novel Tracker (macOS)"
IOS_SCHEME = ENV["NOVEL_TRACKER_IOS_XCODE_SCHEME"] || "Novel Tracker (iOS)"
TEAM_ID = ENV["NOVEL_TRACKER_APPLE_TEAM_ID"] || "3LQK7JJTX2"
APP_BUNDLE_ID = "app.noveltracker.extension"
EXTENSION_BUNDLE_ID = "app.noveltracker.extension.Extension"

MAC_APP_TARGET = "Novel Tracker (macOS)"
MAC_EXTENSION_TARGET = "Novel Tracker Extension (macOS)"
IOS_APP_TARGET = "Novel Tracker (iOS)"
IOS_EXTENSION_TARGET = "Novel Tracker Extension (iOS)"

MAC_APP_PROFILE = "Novel Tracker CI macOS App Store"
MAC_EXTENSION_PROFILE = "Novel Tracker CI macOS Extension App Store"
IOS_APP_PROFILE = "Novel Tracker CI iOS App Store"
IOS_EXTENSION_PROFILE = "Novel Tracker CI iOS Extension App Store"

def connect_api_key
  app_store_connect_api_key(
    key_id: ENV.fetch("APP_STORE_CONNECT_KEY_ID"),
    issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
    key_content: ENV.fetch("APP_STORE_CONNECT_P8"),
    is_key_content_base64: false
  )
end

def distribution_certificate_id(api_key, platform)
  get_certificates(
    api_key: api_key,
    team_id: TEAM_ID,
    platform: platform,
    generate_apple_certs: true,
    skip_set_partition_list: true
  )

  lane_context[SharedValues::CERT_CERTIFICATE_ID]
end

def app_store_profile(api_key, platform, bundle_id, profile_name, certificate_id)
  get_provisioning_profile(
    api_key: api_key,
    team_id: TEAM_ID,
    platform: platform,
    app_identifier: bundle_id,
    provisioning_name: profile_name,
    ignore_profiles_with_different_name: true,
    cert_id: certificate_id
  )

  lane_context[SharedValues::SIGH_NAME]
end

def configure_distribution_signing(target, profile_name)
  update_code_signing_settings(
    use_automatic_signing: false,
    path: PROJECT,
    team_id: TEAM_ID,
    targets: [target],
    build_configurations: ["Release"],
    code_sign_identity: "Apple Distribution",
    profile_name: profile_name
  )
end

platform :mac do
  desc "Archive and upload the macOS Safari extension app to App Store Connect"
  lane :release do
    api_key = connect_api_key
    certificate_id = distribution_certificate_id(api_key, "macos")
    app_profile = app_store_profile(
      api_key,
      "macos",
      APP_BUNDLE_ID,
      MAC_APP_PROFILE,
      certificate_id
    )
    extension_profile = app_store_profile(
      api_key,
      "macos",
      EXTENSION_BUNDLE_ID,
      MAC_EXTENSION_PROFILE,
      certificate_id
    )
    configure_distribution_signing(MAC_APP_TARGET, app_profile)
    configure_distribution_signing(MAC_EXTENSION_TARGET, extension_profile)

    build_app(
      project: PROJECT,
      scheme: MAC_SCHEME,
      export_method: "app-store",
      export_options: {
        signingStyle: "manual",
        signingCertificate: "Apple Distribution",
        teamID: TEAM_ID,
        provisioningProfiles: {
          APP_BUNDLE_ID => app_profile,
          EXTENSION_BUNDLE_ID => extension_profile
        }
      },
      output_directory: File.expand_path("../../../release", __dir__),
      skip_profile_detection: true
    )

    upload_to_app_store(
      skip_screenshots: true,
      skip_metadata: true,
      submit_for_review: false,
      force: true,
      precheck_include_in_app_purchases: false
    )
  end
end

platform :ios do
  desc "Archive and upload the iOS Safari extension app to TestFlight"
  lane :release do
    api_key = connect_api_key
    certificate_id = distribution_certificate_id(api_key, "ios")
    app_profile = app_store_profile(
      api_key,
      "ios",
      APP_BUNDLE_ID,
      IOS_APP_PROFILE,
      certificate_id
    )
    extension_profile = app_store_profile(
      api_key,
      "ios",
      EXTENSION_BUNDLE_ID,
      IOS_EXTENSION_PROFILE,
      certificate_id
    )
    configure_distribution_signing(IOS_APP_TARGET, app_profile)
    configure_distribution_signing(IOS_EXTENSION_TARGET, extension_profile)

    build_app(
      project: PROJECT,
      scheme: IOS_SCHEME,
      export_method: "app-store",
      export_options: {
        signingStyle: "manual",
        signingCertificate: "Apple Distribution",
        teamID: TEAM_ID,
        provisioningProfiles: {
          APP_BUNDLE_ID => app_profile,
          EXTENSION_BUNDLE_ID => extension_profile
        }
      },
      output_directory: File.expand_path("../../../release", __dir__),
      skip_profile_detection: true
    )

    # TestFlight, not a direct App Store submission — matches how this app
    # has been distributed on iOS so far (manually, through Xcode/TestFlight).
    # Internal testers only by default; widen with distribute_external: true
    # once there's an external testing group set up in App Store Connect.
    upload_to_testflight(
      skip_waiting_for_build_processing: true,
      distribute_external: false
    )
  end
end
